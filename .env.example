# Copy this file to .env and edit values:
# cp .env.example .env

# -------------------------------------------------------
# LLM Backend
# -------------------------------------------------------
# Mode A: Internal Ollama
#   Run with: docker compose --profile ollama up
#   Leave LLM_* empty — config.yaml defaults to Ollama.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Mode B: External OpenAI-compatible API (skip Ollama entirely)
#   Set all three values and run: docker compose up
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
#
# OpenRouter example:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# -------------------------------------------------------
# Web frontend (baked into the Docker image at build time)
# -------------------------------------------------------
# The browser's WebSocket URL for the voice-assistant backend.
# Default (ws://localhost:8765) is correct for local Docker use.
# Override if accessing from another machine or behind a proxy.
NEXT_PUBLIC_WS_URL=ws://localhost:8765
NEXT_PUBLIC_WS_TOKEN=

# -------------------------------------------------------
# Optional: n8n workflow tools  (docker compose --profile tools up)
# -------------------------------------------------------
N8N_BASE_URL=http://n8n:5678
