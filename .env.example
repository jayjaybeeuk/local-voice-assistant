# Copy this file to .env and edit values:
# cp .env.example .env

# -----------------------------
# Mode A: Internal Ollama (default)
# -----------------------------
# Leave LLM_* empty to use config.yaml defaults, which point to local Ollama.
# OLLAMA_HOST can stay as-is when using docker compose with the ollama service.
OLLAMA_HOST=http://ollama:11434
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# -----------------------------
# Mode B: External OpenAI-compatible API
# -----------------------------
# Fill all 3 values below to override config.yaml at runtime.
# Example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
#
# For OpenRouter (example):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# -----------------------------
# Optional tools integration (n8n)
# -----------------------------
# Default works with the optional compose n8n service.
# Change this to your hosted/local n8n URL if needed.
N8N_BASE_URL=http://n8n:5678
