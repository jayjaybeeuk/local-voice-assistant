# Daily.co API key (get from https://dashboard.daily.co)
DAILY_API_KEY=your_daily_api_key_here

# Daily room URL (for development/mock mode)
DAILY_ROOM_URL=https://your-domain.daily.co/your-room

# Daily token (optional, for development)
DAILY_TOKEN=your_token_here

# Pipecat backend URL
PIPECAT_BACKEND_URL=http://localhost:7860
